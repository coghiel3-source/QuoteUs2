# ─────────────────────────────────────────────────────────
#  QuoteUs.ca — Environment Variables
#  Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────────

# Node environment — MUST be "production"
NODE_ENV=production

# Port the server listens on (most hosts use 3000 or 8080)
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_URL=postgresql://quoteus_user:yourpassword@localhost:5432/quoteus_db

# Session encryption secret — use a long random string (32+ chars)
SESSION_SECRET=replace_with_a_very_long_random_secret_string_here

# ── Stripe Payments ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Google OAuth (optional — for customer Google login) ──
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── OpenAI (optional — for AI mascot chat) ───────────────
OPENAI_API_KEY=sk-...

# SMTP email settings are stored in the database (Admin → Settings → Email)
